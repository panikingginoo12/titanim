{
  "expo": {
    "name": "Titanim",
    "slug": "titanim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.titanim.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.titanim.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "titanim",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Titanim uses the camera to take daily progress photos of your plants.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Titanim can save a copy of your plant photos to your gallery.",
          "savePhotosPermission": "Titanim can save a copy of your plant photos to your gallery.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F5D3A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Titanim uses your approximate location for local weather tips for your plants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Titanim lets you pick a plant photo to identify it.",
          "cameraPermission": "Titanim uses the camera to take daily progress photos of your plants.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
